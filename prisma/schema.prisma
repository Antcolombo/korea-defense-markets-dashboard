generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum DataStatus {
  AVAILABLE
  UNAVAILABLE
  STALE
  PARTIAL
  ENTITLEMENT_MISSING
  PROVIDER_ERROR
}

enum RevisionFlag {
  ORIGINAL
  REVISED
  CORRECTED
  RESTATED
  UNKNOWN
}

model Ticker {
  id                String                @id @default(cuid())
  ticker            String                @unique
  name              String
  sector            String?
  industry          String?
  country           String?
  assetType         String
  isEtf             Boolean               @default(false)
  description       String?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  asOfDate          DateTime?
  observedAt        DateTime?
  providerTimestamp DateTime?
  ingestedAt        DateTime              @default(now())
  source            String                @default("taxonomy")
  provider          String                @default("internal")
  revisionFlag      RevisionFlag          @default(UNKNOWN)
  dataStatus        DataStatus            @default(AVAILABLE)
  dailyPrices       DailyPrice[]
  signalSnapshots   SignalSnapshot[]
  positioning       PositioningSnapshot[]
  crowding          CrowdingSnapshot[]
  basketMembers     ThemeBasketMember[]

  @@index([ticker])
  @@index([dataStatus])
}

model DailyPrice {
  id                String       @id @default(cuid())
  tickerId          String
  ticker            Ticker       @relation(fields: [tickerId], references: [id], onDelete: Cascade)
  date              DateTime
  open              Float?
  high              Float?
  low               Float?
  close             Float
  adjustedClose     Float?
  volume            BigInt?
  createdAt         DateTime     @default(now())
  asOfDate          DateTime
  observedAt        DateTime
  providerTimestamp DateTime?
  ingestedAt        DateTime     @default(now())
  source            String
  provider          String
  revisionFlag      RevisionFlag @default(UNKNOWN)
  dataStatus        DataStatus   @default(AVAILABLE)

  @@unique([tickerId, date, provider, asOfDate])
  @@index([date])
  @@index([asOfDate])
  @@index([provider, dataStatus])
}

model ThemeBasket {
  id                String              @id @default(cuid())
  slug              String              @unique
  name              String
  description       String
  category          String
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  asOfDate          DateTime?
  observedAt        DateTime?
  providerTimestamp DateTime?
  ingestedAt        DateTime            @default(now())
  source            String              @default("taxonomy")
  provider          String              @default("internal")
  revisionFlag      RevisionFlag        @default(UNKNOWN)
  dataStatus        DataStatus          @default(AVAILABLE)
  members           ThemeBasketMember[]
}

model ThemeBasketMember {
  id                String       @id @default(cuid())
  basketId          String
  basket            ThemeBasket  @relation(fields: [basketId], references: [id], onDelete: Cascade)
  tickerId          String
  ticker            Ticker       @relation(fields: [tickerId], references: [id], onDelete: Cascade)
  weight            Float?
  rationale         String?
  asOfDate          DateTime?
  observedAt        DateTime?
  providerTimestamp DateTime?
  ingestedAt        DateTime     @default(now())
  source            String       @default("taxonomy")
  provider          String       @default("internal")
  revisionFlag      RevisionFlag @default(UNKNOWN)
  dataStatus        DataStatus   @default(AVAILABLE)

  @@unique([basketId, tickerId])
}

model SignalSnapshot {
  id                       String       @id @default(cuid())
  tickerId                 String
  ticker                   Ticker       @relation(fields: [tickerId], references: [id], onDelete: Cascade)
  date                     DateTime
  return1d                 Float?
  return5d                 Float?
  return20d                Float?
  return60d                Float?
  relativeStrengthVsSpy20d Float?
  relativeStrengthVsSpy60d Float?
  volumeVs20dAvg           Float?
  realizedVol20d           Float?
  distanceFrom20dMa        Float?
  distanceFrom50dMa        Float?
  trendLabel               String?
  components               Json?
  excludedUnavailableInputs Json?
  createdAt                DateTime     @default(now())
  asOfDate                 DateTime
  observedAt               DateTime
  providerTimestamp        DateTime?
  ingestedAt               DateTime     @default(now())
  source                   String
  provider                 String
  revisionFlag             RevisionFlag @default(UNKNOWN)
  dataStatus               DataStatus   @default(AVAILABLE)

  @@unique([tickerId, date, provider, asOfDate])
  @@index([date])
  @@index([dataStatus])
}

model PositioningSnapshot {
  id                         String       @id @default(cuid())
  tickerId                   String
  ticker                     Ticker       @relation(fields: [tickerId], references: [id], onDelete: Cascade)
  date                       DateTime
  optionsVolume              Float?
  openInterest               Float?
  putCallRatio               Float?
  impliedVolatility          Float?
  impliedVolPercentile       Float?
  shortInterest              Float?
  shortInterestChange        Float?
  shortVolume                Float?
  shortVolumeRatio           Float?
  positioningNotes           String?
  components                 Json?
  excludedUnavailableInputs  Json?
  createdAt                  DateTime     @default(now())
  asOfDate                   DateTime
  observedAt                 DateTime
  providerTimestamp          DateTime?
  ingestedAt                 DateTime     @default(now())
  source                     String
  provider                   String
  revisionFlag               RevisionFlag @default(UNKNOWN)
  dataStatus                 DataStatus   @default(AVAILABLE)

  @@unique([tickerId, date, provider, asOfDate])
  @@index([date])
  @@index([dataStatus])
}

model OptionContract {
  id                String       @id @default(cuid())
  optionTicker      String       @unique
  underlyingTicker  String
  expirationDate    DateTime
  strikePrice       Float
  contractType      String
  exerciseStyle     String?
  sharesPerContract Int?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  asOfDate          DateTime?
  observedAt        DateTime?
  providerTimestamp DateTime?
  ingestedAt        DateTime     @default(now())
  source            String
  provider          String
  revisionFlag      RevisionFlag @default(UNKNOWN)
  dataStatus        DataStatus   @default(PARTIAL)

  @@index([underlyingTicker, expirationDate, strikePrice])
  @@index([underlyingTicker, contractType])
  @@index([dataStatus])
}

model OptionContractBar {
  id                String       @id @default(cuid())
  optionTicker      String
  underlyingTicker  String
  date              DateTime
  open              Float?
  high              Float?
  low               Float?
  close             Float?
  volume            BigInt?
  vwap              Float?
  transactions      Int?
  createdAt         DateTime     @default(now())
  asOfDate          DateTime
  observedAt        DateTime?
  providerTimestamp DateTime?
  ingestedAt        DateTime     @default(now())
  source            String
  provider          String
  revisionFlag      RevisionFlag @default(UNKNOWN)
  dataStatus        DataStatus   @default(PARTIAL)

  @@unique([optionTicker, date, provider, asOfDate])
  @@index([underlyingTicker, date])
  @@index([optionTicker, date])
  @@index([dataStatus])
}

model OptionsStrikeSignal {
  id                String       @id @default(cuid())
  ticker            String
  date              DateTime
  expirationDate    DateTime
  strikePrice       Float
  callVolume        Float?
  putVolume         Float?
  totalVolume       Float?
  openInterest      Float?
  impliedVolatility Float?
  gamma             Float?
  gammaExposure     Float?
  gammaProxy        Float?
  magnetScore       Float?
  sourceQuality     String
  mode              String
  createdAt         DateTime     @default(now())
  asOfDate          DateTime
  observedAt        DateTime?
  providerTimestamp DateTime?
  ingestedAt        DateTime     @default(now())
  source            String
  provider          String
  revisionFlag      RevisionFlag @default(UNKNOWN)
  dataStatus        DataStatus   @default(PARTIAL)

  @@unique([ticker, date, expirationDate, strikePrice, mode])
  @@index([ticker, date])
  @@index([ticker, expirationDate])
  @@index([mode, sourceQuality])
  @@index([dataStatus])
}

model OptionsBattlefieldSnapshot {
  id                String       @id @default(cuid())
  ticker            String
  date              DateTime
  mode              String
  sourceLabel       String
  callWall          Float?
  putWall           Float?
  zeroGamma         Float?
  expectedMove      Float?
  pressureDirection String?
  confidence        Float?
  payload           Json
  createdAt         DateTime     @default(now())
  asOfDate          DateTime
  observedAt        DateTime?
  providerTimestamp DateTime?
  ingestedAt        DateTime     @default(now())
  source            String
  provider          String
  revisionFlag      RevisionFlag @default(UNKNOWN)
  dataStatus        DataStatus   @default(PARTIAL)

  @@unique([ticker, date, mode, provider, asOfDate])
  @@index([ticker, date])
  @@index([mode])
  @@index([dataStatus])
}

model CrowdingSnapshot {
  id                         String       @id @default(cuid())
  tickerId                   String
  ticker                     Ticker       @relation(fields: [tickerId], references: [id], onDelete: Cascade)
  date                       DateTime
  crowdingScore              Float?
  crowdingLabel              String?
  momentumScore              Float?
  volumeScore                Float?
  optionsScore               Float?
  volatilityScore            Float?
  shortInterestScore         Float?
  catalystScore              Float?
  explanation                String?
  components                 Json?
  excludedUnavailableInputs  Json?
  createdAt                  DateTime     @default(now())
  asOfDate                   DateTime
  observedAt                 DateTime
  providerTimestamp          DateTime?
  ingestedAt                 DateTime     @default(now())
  source                     String
  provider                   String
  revisionFlag               RevisionFlag @default(UNKNOWN)
  dataStatus                 DataStatus   @default(AVAILABLE)

  @@unique([tickerId, date, provider, asOfDate])
  @@index([date])
  @@index([dataStatus])
}

model CatalystEvent {
  id                String       @id @default(cuid())
  date              DateTime
  title             String
  sourceName        String?
  url               String?
  summary           String?
  themeTags         String[]
  tickerTags        String[]
  materialityScore  Float?
  createdAt         DateTime     @default(now())
  asOfDate          DateTime
  observedAt        DateTime
  providerTimestamp DateTime?
  ingestedAt        DateTime     @default(now())
  source            String
  provider          String
  revisionFlag      RevisionFlag @default(UNKNOWN)
  dataStatus        DataStatus   @default(AVAILABLE)

  @@index([date])
  @@index([dataStatus])
}

model StockPitch {
  id             String   @id @default(cuid())
  slug           String   @unique
  ticker         String
  companyName    String
  recommendation String
  status         String   @default("draft")
  shareToken     String   @unique
  shareEnabled   Boolean  @default(false)
  payload        Json
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  publishedAt    DateTime?

  @@index([ticker])
  @@index([status])
  @@index([shareEnabled])
}

model InvestmentDecision {
  id                 String   @id @default(cuid())
  slug               String   @unique
  ticker             String
  companyName        String
  status             String   @default("watch")
  decision           String   @default("watch")
  marketBelief       String   @default("")
  variantView        String   @default("")
  evidenceJson       Json
  riskJson           Json
  invalidation       String   @default("")
  timeHorizon        String?
  expectedReturn     Float?
  downside           Float?
  sourceSnapshotJson Json?
  outcomeReturn      Float?
  lesson             String?
  isPublic           Boolean  @default(false)
  featuredRank       Int?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([ticker])
  @@index([status])
  @@index([decision])
  @@index([isPublic, featuredRank])
}

model AiScan {
  id             String   @id @default(cuid())
  ticker         String
  mode           String
  inputHash      String
  model          String
  status         String
  payload        Json?
  sourceSnapshot Json
  errorMessage   String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([ticker, mode, inputHash])
  @@index([ticker, mode, createdAt])
  @@index([status])
}

model ProviderRun {
  id                String       @id @default(cuid())
  provider          String
  source            String
  startedAt         DateTime     @default(now())
  finishedAt        DateTime?
  asOfDate          DateTime?
  observedAt        DateTime?
  providerTimestamp DateTime?
  ingestedAt        DateTime     @default(now())
  rowsIngested      Int          @default(0)
  errorMessage      String?
  metadata          Json?
  revisionFlag      RevisionFlag @default(UNKNOWN)
  dataStatus        DataStatus

  @@index([provider, dataStatus])
  @@index([asOfDate])
}

model ValidationResult {
  id                String       @id @default(cuid())
  testName          String
  asOfDate          DateTime
  lookbackStart     DateTime?
  lookbackEnd       DateTime?
  hitRate           Float?
  averageForwardReturn Float?
  sampleSize        Int
  coveragePercent   Float
  caveats           String?
  resultRows        Json?
  createdAt         DateTime     @default(now())
  observedAt        DateTime
  providerTimestamp DateTime?
  ingestedAt        DateTime     @default(now())
  source            String
  provider          String
  revisionFlag      RevisionFlag @default(UNKNOWN)
  dataStatus        DataStatus   @default(AVAILABLE)

  @@index([testName, asOfDate])
  @@index([dataStatus])
}

model FundamentalSnapshot {
  id                String       @id @default(cuid())
  ticker            String
  periodEnd         DateTime
  fiscalPeriod      String
  currency          String       @default("USD")
  revenue           Float?
  grossProfit       Float?
  operatingIncome   Float?
  ebitda            Float?
  netIncome         Float?
  epsDiluted        Float?
  freeCashFlow      Float?
  cash              Float?
  debt              Float?
  sharesDiluted     Float?
  payload           Json?
  createdAt         DateTime     @default(now())
  asOfDate          DateTime
  observedAt        DateTime
  providerTimestamp DateTime?
  ingestedAt        DateTime     @default(now())
  source            String
  provider          String
  revisionFlag      RevisionFlag @default(UNKNOWN)
  dataStatus        DataStatus   @default(PARTIAL)

  @@unique([ticker, periodEnd, fiscalPeriod, provider, asOfDate])
  @@index([ticker, periodEnd])
  @@index([asOfDate])
  @@index([dataStatus])
}

model EstimateSnapshot {
  id                String       @id @default(cuid())
  ticker            String
  periodEnd         DateTime
  fiscalPeriod      String
  estimateDate      DateTime
  revenueEstimate   Float?
  epsEstimate       Float?
  ebitdaEstimate    Float?
  payload           Json?
  createdAt         DateTime     @default(now())
  asOfDate          DateTime
  observedAt        DateTime
  providerTimestamp DateTime?
  ingestedAt        DateTime     @default(now())
  source            String
  provider          String
  revisionFlag      RevisionFlag @default(UNKNOWN)
  dataStatus        DataStatus   @default(PARTIAL)

  @@unique([ticker, periodEnd, fiscalPeriod, estimateDate, provider, asOfDate])
  @@index([ticker, periodEnd])
  @@index([estimateDate])
  @@index([dataStatus])
}

model ValuationSnapshot {
  id                String       @id @default(cuid())
  ticker            String
  date              DateTime
  marketCap         Float?
  enterpriseValue   Float?
  peRatio           Float?
  evSales           Float?
  evEbitda          Float?
  fcfYield          Float?
  payload           Json?
  createdAt         DateTime     @default(now())
  asOfDate          DateTime
  observedAt        DateTime
  providerTimestamp DateTime?
  ingestedAt        DateTime     @default(now())
  source            String
  provider          String
  revisionFlag      RevisionFlag @default(UNKNOWN)
  dataStatus        DataStatus   @default(PARTIAL)

  @@unique([ticker, date, provider, asOfDate])
  @@index([ticker, date])
  @@index([dataStatus])
}

model FactorExposureSnapshot {
  id                String       @id @default(cuid())
  ticker            String
  date              DateTime
  exposures         Json
  beta              Float?
  residualVariance  Float?
  rSquared          Float?
  observations      Int
  createdAt         DateTime     @default(now())
  asOfDate          DateTime
  observedAt        DateTime
  providerTimestamp DateTime?
  ingestedAt        DateTime     @default(now())
  source            String
  provider          String
  revisionFlag      RevisionFlag @default(UNKNOWN)
  dataStatus        DataStatus   @default(PARTIAL)

  @@unique([ticker, date, provider, asOfDate])
  @@index([ticker, date])
  @@index([dataStatus])
}

model RiskModelRun {
  id                String       @id @default(cuid())
  name              String
  date              DateTime
  factors           String[]
  factorCovariance  Json
  payload           Json
  createdAt         DateTime     @default(now())
  asOfDate          DateTime
  observedAt        DateTime
  providerTimestamp DateTime?
  ingestedAt        DateTime     @default(now())
  source            String
  provider          String
  revisionFlag      RevisionFlag @default(UNKNOWN)
  dataStatus        DataStatus   @default(PARTIAL)

  @@index([name, date])
  @@index([dataStatus])
}

model PmDecisionOverlay {
  id                String       @id @default(cuid())
  decisionSlug      String
  ticker            String
  date              DateTime
  pmReady           Boolean      @default(false)
  expectedValue     Float?
  costAdjustedEv    Float?
  suggestedSizePct  Float?
  activeCapReason   String?
  payload           Json
  createdAt         DateTime     @default(now())
  asOfDate          DateTime
  observedAt        DateTime
  providerTimestamp DateTime?
  ingestedAt        DateTime     @default(now())
  source            String
  provider          String
  revisionFlag      RevisionFlag @default(UNKNOWN)
  dataStatus        DataStatus   @default(PARTIAL)

  @@unique([decisionSlug, date, provider, asOfDate])
  @@index([ticker, date])
  @@index([pmReady])
  @@index([dataStatus])
}

model PortfolioOptimizationRun {
  id                String       @id @default(cuid())
  name              String
  date              DateTime
  nav               Float
  grossExposure     Float?
  netExposure       Float?
  portfolioBeta     Float?
  costAdjustedEv    Float?
  payload           Json
  createdAt         DateTime     @default(now())
  asOfDate          DateTime
  observedAt        DateTime
  providerTimestamp DateTime?
  ingestedAt        DateTime     @default(now())
  source            String
  provider          String
  revisionFlag      RevisionFlag @default(UNKNOWN)
  dataStatus        DataStatus   @default(PARTIAL)

  @@index([name, date])
  @@index([dataStatus])
}

model PortfolioRiskSnapshot {
  id                String       @id @default(cuid())
  name              String
  date              DateTime
  annualizedRisk    Float?
  valueAtRisk95     Float?
  valueAtRisk99     Float?
  expectedShortfall Float?
  liquidityDays     Float?
  payload           Json
  createdAt         DateTime     @default(now())
  asOfDate          DateTime
  observedAt        DateTime
  providerTimestamp DateTime?
  ingestedAt        DateTime     @default(now())
  source            String
  provider          String
  revisionFlag      RevisionFlag @default(UNKNOWN)
  dataStatus        DataStatus   @default(PARTIAL)

  @@index([name, date])
  @@index([dataStatus])
}

model BacktestRun {
  id                String       @id @default(cuid())
  name              String
  date              DateTime
  lookbackStart     DateTime?
  lookbackEnd       DateTime?
  hitRate           Float?
  informationCoefficient Float?
  averageForwardReturn Float?
  sharpe            Float?
  maxDrawdown       Float?
  turnover          Float?
  capacity          Float?
  netReturn         Float?
  payload           Json
  createdAt         DateTime     @default(now())
  asOfDate          DateTime
  observedAt        DateTime
  providerTimestamp DateTime?
  ingestedAt        DateTime     @default(now())
  source            String
  provider          String
  revisionFlag      RevisionFlag @default(UNKNOWN)
  dataStatus        DataStatus   @default(PARTIAL)

  @@index([name, date])
  @@index([dataStatus])
}
