{
  "name": "flow-positioning-research-terminal",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "npm run audit:data && next build",
    "build:data": "npm run ingest:terminal && npm run validate:research && npm run audit:data",
    "build:generated": "npm run ingest:generated && tsx scripts/build_real_dataset.ts && tsx scripts/build_korea_macro.ts && tsx scripts/build_semis_cycle.ts && tsx scripts/build_energy_research.ts && tsx scripts/build_research_os.ts && npm run audit:source",
    "ingest": "npm run ingest:terminal",
    "ingest:terminal": "tsx scripts/ingest_flow_terminal.ts",
    "ingest:generated": "tsx scripts/ingest_events.ts && tsx scripts/ingest_market_data.ts && tsx scripts/ingest_macro.ts && tsx scripts/ingest_energy.ts && tsx scripts/ingest_filings.ts && tsx scripts/ingest_korea_market_data.ts && tsx scripts/ingest_korea_macro_flows.ts",
    "db:seed": "tsx scripts/seed_flow_terminal.ts",
    "db:migrate": "prisma migrate dev",
    "prisma:generate": "prisma generate",
    "validate:research": "tsx scripts/validate_flow_terminal.ts",
    "audit:data": "tsx scripts/audit_flow_terminal.ts",
    "audit:source": "tsx scripts/audit_sources.ts",
    "setup:check": "tsx scripts/check_setup.ts",
    "lint:styles": "tsx scripts/check_style_boundaries.ts",
    "start": "next start",
    "lint": "npm run lint:styles && tsc --noEmit"
  },
  "dependencies": {
    "@headlessui/react": "^2.2.10",
    "@prisma/client": "^6.18.0",
    "@radix-ui/react-slot": "^1.3.0",
    "@remixicon/react": "^4.9.0",
    "@tanstack/react-table": "^8.21.3",
    "@tremor/react": "^3.18.7",
    "@types/node": "^22.15.19",
    "@types/react": "^19.1.6",
    "@types/react-dom": "^19.1.5",
    "autoprefixer": "^10.4.21",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "lightweight-charts": "^5.2.0",
    "lucide-react": "^1.21.0",
    "next": "^15.3.3",
    "postcss": "^8.5.3",
    "radix-ui": "^1.6.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-resizable-panels": "^4.11.2",
    "recharts": "^2.15.3",
    "shadcn": "^4.11.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.4",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.8.3"
  },
  "devDependencies": {
    "@tailwindcss/forms": "^0.5.11",
    "prisma": "^6.18.0"
  }
}
