{
  "name": "korea-defense-markets-dashboard",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "demo": "RESEARCH_DATA_MODE=generated next dev",
    "demo:build": "RESEARCH_DATA_MODE=generated next build",
    "demo:start": "RESEARCH_DATA_MODE=generated next start",
    "build": "next build",
    "build:data": "npm run pipeline:data",
