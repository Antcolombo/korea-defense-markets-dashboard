    "ingest": "npm run ingest:terminal",
    "ingest:terminal": "tsx scripts/ingest_flow_terminal.ts",
    "ingest:positioning": "FLOW_TERMINAL_POSITIONING_ONLY=true ENABLE_MASSIVE_OPTIONS=true ALLOW_LIVE_POSITIONING_WITH_DEMO_ASOF=true tsx scripts/ingest_flow_terminal.ts",
    "ingest:generated": "tsx scripts/ingest_events.ts && tsx scripts/ingest_market_data.ts && tsx scripts/ingest_macro.ts && tsx scripts/ingest_energy.ts && tsx scripts/ingest_filings.ts && tsx scripts/ingest_korea_market_data.ts && tsx scripts/ingest_korea_macro_flows.ts",
    "import:fundamentals": "tsx scripts/import_fundamentals.ts",
    "import:estimates": "tsx scripts/import_estimates.ts",
    "build:pm-engine": "tsx scripts/run_pm_engine.ts",
    "db:seed": "tsx scripts/seed_flow_terminal.ts",
    "db:seed:decisions": "tsx scripts/seed_investment_decisions.ts",
    "db:migrate": "prisma migrate dev",
    "prisma:generate": "prisma generate",
    "validate:research": "tsx scripts/validate_flow_terminal.ts",
    "audit:data": "tsx scripts/audit_flow_terminal.ts",
    "audit:source": "tsx scripts/audit_sources.ts",
    "setup:check": "tsx scripts/check_setup.ts",
    "test:trust": "tsx scripts/test_trust_patch.ts",
    "test:decisions": "tsx scripts/test_decision_validation.ts",
    "test:pm": "tsx scripts/test_pm_engine.ts",
    "test:api": "tsx scripts/test_api_routes.ts",
    "test:workspace": "tsx scripts/test_workspace_loaders.ts",
    "test:repositories": "tsx scripts/test_repository_services.ts",
    "test:ingestion": "tsx scripts/test_ingestion_lifecycle.ts",
    "test:pitches": "tsx scripts/test_pitch_domain.ts",
    "test:retention:generated": "tsx scripts/test_generated_retention.ts",
    "retention:generated": "tsx scripts/prune_generated_data.ts",
    "smoke:click": "playwright test scripts/click_smoke.spec.mjs",
    "lint:styles": "tsx scripts/check_style_boundaries.ts",
    "lint:architecture": "tsx scripts/check_architecture.ts",
    "start": "next start",
    "lint": "npm run lint:styles && npm run lint:architecture && tsc --noEmit"
  },
